<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Console app: there is no SynchronizationContext to escape. -->
		<NoWarn>$(NoWarn);MA0004</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>svgtoassets</ToolCommandName>
		<PackageId>SvgToAssets</PackageId>
		<Version>0.1.0</Version>
		<Authors>Andrew Beers</Authors>
		<Description>Rasterizes SVGs into WinUI app assets and multi-size .ico files.</Description>
		<PackageTags>svg;winui;assets;icon;png</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SvgToAssets.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DotNext" />
		<PackageReference Include="DotNext.IO" />
		<PackageReference Include="DotNext.Threading" />
		<PackageReference Include="Meziantou.Analyzer">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Meziantou.Framework.ByteSize" />
		<PackageReference Include="Meziantou.Framework.FullPath" />
		<PackageReference Include="Meziantou.Framework.Globbing" />
		<PackageReference Include="Meziantou.Framework.Slug" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Enrichers.Memory" />
		<PackageReference Include="Serilog.Enrichers.Process" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<PackageReference Include="Serilog.Formatting.Compact" />
		<PackageReference Include="Serilog.Sinks.Async" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.Debug" />
		<PackageReference Include="SerilogAnalyzer" />
		<PackageReference Include="Spectre.Console" />
		<PackageReference Include="Svg.Skia" />
		<!-- SkiaSharp brings Windows and macOS natives on its own; Linux needs this. -->
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" />
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>

	<PropertyGroup>
		<!-- x64 desktops only: Skia fails to load anywhere else. The osx natives are universal, so Apple Silicon comes along. -->
		<ToolNativeRuntimes>;win-x64;linux-x64;osx;</ToolNativeRuntimes>
	</PropertyGroup>

	<!-- ponytail: one portable package carries every kept platform; RID-specific tool packages would ship one each if size matters. -->
	<Target Name="TrimToolNativeAssets" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<!-- Drops unlisted platforms and the ~390 MB of .pdb files the Windows natives ship with. -->
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="'%(ResolvedFileToPublish.AssetType)' == 'native' And ('%(ResolvedFileToPublish.Extension)' == '.pdb' Or !$(ToolNativeRuntimes.Contains(';%(ResolvedFileToPublish.RuntimeIdentifier);')))" />
		</ItemGroup>
	</Target>

</Project>
