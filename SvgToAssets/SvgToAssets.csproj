<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- Plain net10.0: PackAsTool rejects platform TFMs (NETSDK1146).
		     Linux/macOS work via libgdiplus only while Svg pulls System.Drawing.Common 5.x; 6.0+ is Windows-only. -->
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Console app: there is no SynchronizationContext to escape. -->
		<NoWarn>$(NoWarn);MA0004</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>svgtoassets</ToolCommandName>
		<PackageId>SvgToAssets</PackageId>
		<Version>0.1.0</Version>
		<Authors>Andrew Beers</Authors>
		<Description>Rasterizes SVGs into WinUI app assets and multi-size .ico files.</Description>
		<PackageTags>svg;winui;assets;icon;png</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SvgToAssets.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DotNext" />
		<PackageReference Include="DotNext.IO" />
		<PackageReference Include="DotNext.Threading" />
		<PackageReference Include="Meziantou.Analyzer">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Meziantou.Framework.ByteSize" />
		<PackageReference Include="Meziantou.Framework.FullPath" />
		<PackageReference Include="Meziantou.Framework.Globbing" />
		<PackageReference Include="Meziantou.Framework.Slug" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Enrichers.Memory" />
		<PackageReference Include="Serilog.Enrichers.Process" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<PackageReference Include="Serilog.Formatting.Compact" />
		<PackageReference Include="Serilog.Sinks.Async" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.Debug" />
		<PackageReference Include="SerilogAnalyzer" />
		<PackageReference Include="Spectre.Console" />
		<PackageReference Include="Svg" />
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>

</Project>
